// Optional extraction-only resource override. Adapt queue/account/container to your site.
process {
  withLabel: 'trajectory_extract' {
    executor = 'slurm'
    cpus = 4
    memory = '8 GB'
    time = '10 min'
    // queue = 'YOUR_PARTITION'
    // clusterOptions = '--account=YOUR_ACCOUNT'
    // container = '/path/to/architecture-compatible.sif'
  }
}
