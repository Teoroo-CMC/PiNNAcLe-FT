&GLOBAL
   PROJECT Proton
   RUN_TYPE ENERGY_FORCE
   PRINT_LEVEL LOW
   EXTENDED_FFT_LENGTHS TRUE
&END GLOBAL

&FORCE_EVAL
   METHOD Quickstep
   STRESS_TENSOR ANALYTICAL
   &DFT
      BASIS_SET_FILE_NAME  BASIS_MOLOPT_UZH
      POTENTIAL_FILE_NAME  POTENTIAL_UZH

      CHARGE 1
      MULTIPLICITY 1

      &MGRID
        CUTOFF 1200
        REL_CUTOFF 60
        NGRIDS 4
      &END MGRID

      &QS
        EPS_DEFAULT 1.0E-12
        EPS_PGF_ORB 1.0E-14
      &END QS

      &POISSON
         PERIODIC XYZ
      &END POISSON

      &SCF
         EPS_SCF 1.0E-6
         SCF_GUESS ATOMIC
         MAX_SCF 50
         &OUTER_SCF
           EPS_SCF 1.0E-6
           MAX_SCF 50
         &END
         &OT ON
           PRECONDITIONER FULL_SINGLE_INVERSE
         &END OT
      &END SCF

      &XC
         &XC_FUNCTIONAL
            &MGGA_X_r2SCAN
            &END
            &MGGA_C_r2SCAN
            &END
         &END XC_FUNCTIONAL
      &END XC

   &END DFT

   &SUBSYS
      &PRINT
        &ATOMIC_COORDINATES ON
        &END ATOMIC_COORDINATES
        &CELL ON
        &END CELL
      &END PRINT
      &KIND O
         BASIS_SET TZV2P-MOLOPT-SCAN-GTH-q6
         POTENTIAL GTH-SCAN-q6
      &END KIND
      &KIND H
         BASIS_SET TZV2P-MOLOPT-SCAN-GTH-q1
         POTENTIAL GTH-SCAN-q1
      &END KIND

   &END SUBSYS

   &PRINT
     &FORCES ON
     &END FORCES
     &STRESS_TENSOR ON
     &END STRESS_TENSOR
   &END PRINT

&END FORCE_EVAL
