// Optional MD-only estimate. Calibrate seconds/ps for the model and hardware.
params.adaptive_md_walltime = false
params.md_seconds_per_ps = 40.0
params.md_walltime_overhead_minutes = 3.0
params.md_walltime_min_minutes = 10.0

if (params.adaptive_md_walltime) {
  process {
    withName: 'md' {
      time = {
        // The workflow appends --t; use its last value, as the MD parser does.
        def durations = (flags =~ /(?:^|\s)--t[\s,=]+(\S+)/)
        assert durations : 'Adaptive MD walltime requires --t (duration in ps)'
        def ps = durations[-1][1].toDouble()
        def rate = params.md_seconds_per_ps.toDouble()
        def overhead = params.md_walltime_overhead_minutes.toDouble()
        def minimum = params.md_walltime_min_minutes.toDouble()
        assert [ps, rate, overhead, minimum].every { Double.isFinite(it) } &&
          ps > 0 && rate > 0 && overhead >= 0 && minimum > 0 :
          'MD duration, seconds/ps and minimum must be positive; overhead must be nonnegative; all must be finite'
        def minutes = Math.ceil(Math.max(minimum, ps * rate / 60.0 + overhead))
        assert Double.isFinite(minutes) : 'Adaptive MD walltime overflow'
        return "${minutes.toLong()}min"
      }
    }
  }
}

profiles {
  alvis {
    params{
      cp2k_cmd = 'mpirun -n 4 cp2k.psmp'
    }

    executor{
      name = 'slurm'
      queueSize = 100
      submitRateLimit = '120 min'
    }

    process {
      time = '7d'
      accelerator = 1
      executor = 'slurm'

      beforeScript = '''
                module load Python/3.10.8-GCCcore-12.2.0
                source /mimer/NOBACKUP/groups/snic2022-5-322/zzy_data/my_python310/bin/activate
                export PYTHONPATH=/cephyr/users/zhanyun/Alvis/userData/PiNNAcLe-FT/bin:$PYTHONPATH
                '''

      withLabel: 'tips|molutils' {executor='local'}
      withLabel: 'pinn' {
        queue = 'alvis'
        time = '4d'
        clusterOptions = '-N 1 -n 1 -A your_account --gpus-per-node=V100:1 -J Pinnacle'
      }
      withLabel: 'cp2k' {
        time = '1d'
        clusterOptions = '-N 1 -n 1 -A your_account --gpus-per-node=V100:1 -J Cp2Kacle'
        container='/cephyr/users/zhanyun/Alvis/images/cp2k2023_2.sif'
      }
      withLabel: 'mace|tools' {
        executor='local'
      }
    }

    singularity {
      enabled = true
      autoMounts = true
      runOptions = '--nv'
    }
  }

  arrhen {
    params{
      cp2k_cmd = 'mpirun -n 4 /software/sse2/el9_gh200/easybuild/prefix/software/CP2K/2026.2-gmpichcnvpl-14.3.0/bin/cp2k.psmp'
      acle_dir = '/nobackup/proj/disk/snic2022-5-322/shared/zhanyun/PiNNAcLe-FT'
    }

    executor{
      name = 'slurm'
      queueSize = 100
      submitRateLimit = '120 min'
    }

    process {
      time = '3d'
      accelerator = 1
      executor = 'slurm'

      withLabel: 'tips|molutils|tools' {
        executor='local'
        container="${params.acle_dir}/docker/PiNN/pinn-cpu-acle.sif"
     }
      withLabel: 'pinn' {
        queue = 'gpu'
        time = '1d'
        clusterOptions = '-N 1 -n 1 -A naiss2026-3-693-gpu --gpus 1 -J pinnacle'
        container="${params.acle_dir}/docker/PiNN/pinn-gpu-acle.sif"
      }
      withLabel: 'cp2k' {
        queue = 'gpu'
        time = '1d'
        clusterOptions = '-N 1 -n 1 -A naiss2026-3-693-gpu --gpus 1 -J cp2kacle'
        beforeScript = '''
                module load GPU/buildtool-easybuild/5.2.1-hpca3ef7d197
                module load gmpichcnvpl/14.3.0
                '''
      }
      withLabel: 'mace' {
        queue = 'gpu'
        time = '1h'
        clusterOptions = '-N 1 -n 1 -A naiss2026-3-693-gpu --gpus 1 -J maceacle'
        beforeScript = '''
                module load GPU/Miniforge/26.3.2-2-eb
                conda activate /nobackup/proj/disk/snic2022-5-322/shared/zhanyun/conda_envs/pinnacle
                '''
      }
    }

    singularity {
      enabled = true
      autoMounts = false
      runOptions = "--nv -B /nobackup/proj/disk/snic2022-5-322 --env PYTHONPATH=${params.acle_dir}/bin"
    }
  }

}
